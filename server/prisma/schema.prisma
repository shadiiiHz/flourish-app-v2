generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum CategoryTab {
  bakery
  drinks
}

enum OrderStatus {
  pending
  confirmed
  preparing
  ready
  delivered
  cancelled
}

enum PaymentStatus {
  pending
  paid
  failed
}

enum OrderType {
  instant
  preorder
}

enum DeliveryMethod {
  delivery
  pickup
}

enum WalletTransactionType {
  cashback
  redeem
  refund
  cashback_reversal
  cashback_expired
}

model HeroSlide {
  id        String   @id @default(cuid())
  image     String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Category {
  id        String      @id @default(cuid())
  slug      String      @unique
  tab       CategoryTab
  title     String
  image     String?
  note      String?
  sortOrder Int         @default(0)
  products  Product[]
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
}

model Product {
  id                   String           @id @default(cuid())
  /// Null only for combo products (isCombo=true) — they have no category and never appear on /menu.
  categoryId           String?
  category             Category?        @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  title                String
  description          String           @default("")
  price                Int
  images               String[]         @default([])
  weight               String?
  ingredients          String?
  servingSize          String?
  discountPercent      Int?
  stock                Int?
  isNew                Boolean          @default(false)
  isAvailable          Boolean          @default(true)
  allowPreorder        Boolean          @default(true)
  sortOrder            Int              @default(0)
  /// Homepage-only combo item (no category) shown in its own section, never on /menu.
  isCombo              Boolean          @default(false)
  /// Combo items only. Null means it stays until the admin deletes it.
  comboExpiresAt       DateTime?
  /// Combo items only. Shows a "N days left" ribbon on the card — only meaningful when comboExpiresAt is set.
  comboShowExpiryBadge Boolean          @default(false)
  variants             ProductVariant[]
  orderItems           OrderItem[]
  cartItems            CartItem[]
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt
}

model ProductVariant {
  id          String      @id @default(cuid())
  productId   String
  product     Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  title       String
  description String?
  price       Int
  weight      String?
  stock       Int?
  image       String?
  orderItems  OrderItem[]
  cartItems   CartItem[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}

model Customer {
  id                 String              @id @default(cuid())
  phone              String              @unique
  passwordHash       String?
  firstName          String?
  lastName           String?
  email              String?
  avatar             String?
  /// Optional — only the month/day are used, to generate a birthday discount code each year.
  birthDate          DateTime?
  walletBalance      Int                 @default(0)
  orders             Order[]
  addresses          Address[]
  cartItems          CartItem[]
  walletTransactions WalletTransaction[]
  discountCodes      DiscountCode[]
  adminMessages      AdminMessage[]
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
}

model CartItem {
  id         String          @id @default(cuid())
  customerId String
  customer   Customer        @relation(fields: [customerId], references: [id], onDelete: Cascade)
  productId  String
  product    Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variantId  String?
  variant    ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)
  quantity   Int
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt
}

model Address {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  title      String?
  address    String
  details    String?
  phone      String?
  lat        Float?
  lng        Float?
  isDefault  Boolean  @default(false)
  orders     Order[]
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Order {
  id                   String              @id @default(cuid())
  /**
   * Short, human-facing, DB-guaranteed-unique order number — display as #<orderNumber>.
   */
  orderNumber          Int                 @unique @default(autoincrement())
  customerId           String?
  customer             Customer?           @relation(fields: [customerId], references: [id], onDelete: SetNull)
  customerPhone        String
  customerName         String?
  status               OrderStatus         @default(pending)
  orderType            OrderType           @default(instant)
  deliveryMethod       DeliveryMethod      @default(delivery)
  scheduledDate        DateTime?
  scheduledTimeSlot    String?
  addressId            String?
  address              Address?            @relation(fields: [addressId], references: [id], onDelete: SetNull)
  addressText          String?
  distanceKm           Float?
  subtotal             Int
  discountCode         String?
  discountAmount       Int                 @default(0)
  tax                  Int
  shippingCost         Int                 @default(0)
  total                Int
  note                 String?
  paymentStatus        PaymentStatus       @default(pending)
  paymentAuthority     String?
  paymentRefId         String?
  walletAmountUsed     Int                 @default(0)
  walletCashbackAmount Int                 @default(0)
  items                OrderItem[]
  walletTransactions   WalletTransaction[]
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
}

model OrderItem {
  id           String          @id @default(cuid())
  orderId      String
  order        Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId    String?
  product      Product?        @relation(fields: [productId], references: [id], onDelete: SetNull)
  variantId    String?
  variant      ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  title        String
  variantTitle String?
  price        Int
  quantity     Int
}

enum DiscountCodeSource {
  manual
  birthday
}

model DiscountCode {
  id          String             @id @default(cuid())
  code        String             @unique
  percent     Int
  isActive    Boolean            @default(true)
  source      DiscountCodeSource @default(manual)
  /// Set only for a personal, single-customer code (e.g. birthday codes). Null means anyone can use it.
  customerId  String?
  customer    Customer?          @relation(fields: [customerId], references: [id], onDelete: Cascade)
  /// Restricts the code to one specific calendar day (Asia/Tehran). Null means no date restriction.
  validOnDate DateTime?
  /// Set once redeemed on an order — only enforced for customer-scoped codes; generic codes stay reusable.
  usedAt      DateTime?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
}

model Settings {
  id                    Int      @id @default(1)
  shippingCostUpTo5Km   Int      @default(0)
  shippingCostOver5Km   Int      @default(0)
  /**
   * Addresses farther than this from the store can't be delivered to — pickup only.
   */
  maxDeliveryRadiusKm   Int      @default(8)
  /**
   * When true, only preorders can be placed — instant ordering is closed site-wide.
   */
  siteClosed            Boolean  @default(false)
  /**
   * When true, instant ordering is also closed automatically outside of
   * [businessHoursStart, businessHoursEnd) in Asia/Tehran time, independent of siteClosed.
   */
  businessHoursEnabled  Boolean  @default(true)
  /**
   * "HH:mm" in Asia/Tehran time.
   */
  businessHoursStart    String   @default("09:00")
  /**
   * "HH:mm" in Asia/Tehran time.
   */
  businessHoursEnd      String   @default("22:30")
  /**
   * Percent of an order's item subtotal (pre-tax, pre-discount, pre-shipping) credited to the
   * customer's wallet as cashback once the order is paid.
   */
  walletCashbackPercent Int      @default(0)
  /**
   * Overrides the default banner image on the public menu page. Null means the
   * built-in /assets/cat-banner.jpg ships as-is.
   */
  menuBannerImage       String?
  updatedAt             DateTime @updatedAt
}

model WalletTransaction {
  id              String                @id @default(cuid())
  customerId      String
  customer        Customer              @relation(fields: [customerId], references: [id], onDelete: Cascade)
  type            WalletTransactionType
  /**
   * Signed amount in Toman — positive for credits (cashback, refund), negative for debits (redeem).
   */
  amount          Int
  balanceAfter    Int
  orderId         String?
  order           Order?                @relation(fields: [orderId], references: [id], onDelete: SetNull)
  note            String?
  /**
   * Only set on "cashback" rows: how much of that specific cashback grant is
   * still unspent. Consumed (FIFO, oldest grant first) as the customer spends
   * from their wallet, and zeroed out early if the underlying order's
   * cashback is reversed. Whatever is still positive once expiresAt passes
   * gets clawed back — see expireStaleWalletCashback in lib/wallet.ts.
   */
  remainingAmount Int?
  /**
   * Only set on "cashback" rows: when this grant's one-month usage window ends.
   */
  expiresAt       DateTime?
  createdAt       DateTime              @default(now())
}

model AdminUser {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  role         String   @default("admin")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

enum AdminMessageType {
  birthday
}

/// A notification inbox for the admin — e.g. "it's this customer's birthday, generate their discount code".
model AdminMessage {
  id         String           @id @default(cuid())
  type       AdminMessageType
  customerId String?
  customer   Customer?        @relation(fields: [customerId], references: [id], onDelete: Cascade)
  title      String
  body       String
  isRead     Boolean          @default(false)
  /// Set once the action tied to this message (e.g. generating a discount code) has been taken.
  actionedAt DateTime?
  createdAt  DateTime         @default(now())

  @@index([customerId])
}
